# THIS REPO IS PUBLIC. Never commit student data or answer keys.
# Protection must not depend on remembering a filename prefix, so this is
# deliberately broad — rename a file rather than loosening a rule.
roster_*.sql
roster_*.csv
*roster*.csv
*students*.csv
*_answers*.csv
*answer_key*.csv
*answer_key*.txt
# ...but sql/ is schema and migrations only — never content. Keep it tracked
# so a migration named after the thing it protects is not silently dropped.
!sql/**
# Per-student / per-section working files (contain names, emails, IDs)
transfer_*.sql
coinstructor_*.sql
